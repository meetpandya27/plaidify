# ══════════════════════════════════════════════════════════════════════════════
# Plaidify — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values before running the app:
#
#   cp .env.example .env
#
# Every setting the app reads (src/config.py) and every variable the scripts,
# gunicorn.conf.py and the image entrypoint read is listed here with its
# default. Only the two REQUIRED values have no default; the app refuses to
# start without them. A commented line shows the default (an example where
# the default is unset); uncomment it to change the value. An empty value is
# not the same as unset for most settings, so leave a line commented unless
# you mean to set it.
#
# Public repo note: keep real production values in your secrets manager
# (GitHub environment secrets, Azure Key Vault, ...), never in this repository.
#
# Docker Compose: docker-compose.yml reads this file too, but builds
# DATABASE_URL and REDIS_URL itself from .secrets/postgres_password and
# .secrets/redis_password (docs/DEPLOYMENT.md, "Quick Start").
# ══════════════════════════════════════════════════════════════════════════════

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# 256-bit key (base64url) that wraps every user's data key (KMS_PROVIDER=local).
# Losing it makes stored credentials unrecoverable. Generate with:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
# Signs access tokens. At least 32 characters (startup refuses shorter).
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# ── Encryption key rotation (SECURITY.md, "Key Rotation Procedure") ─────────
# ENCRYPTION_KEY_VERSION=1          # increment when ENCRYPTION_KEY changes
# The previous ENCRYPTION_KEY, kept until the rotation is done
# ENCRYPTION_KEY_PREVIOUS=

# ── Key Management Service (docs/KMS_INTEGRATION.md) ─────────────────────────
# Where user data keys are wrapped: 'local' (ENCRYPTION_KEY), 'aws', 'azure'
# or 'vault'. The cloud SDKs are only in an image built with
# --build-arg INSTALL_KMS=true.
# KMS_PROVIDER=local
# AWS key ARN or alias (AWS only: Azure and Vault read KMS_AZURE_KEY_NAME / KMS_VAULT_KEY_NAME)
# KMS_KEY_ID=
# AWS region
# KMS_REGION=
# AWS_DEFAULT_REGION=us-east-1      # AWS: used when KMS_REGION is unset
# AWS key, used when KMS_KEY_ID is unset
# KMS_AWS_KEY_ID=
# Azure Key Vault URL, https://<vault>.vault.azure.net/
# KMS_AZURE_VAULT_URL=
# KMS_AZURE_KEY_NAME=plaidify-master  # Azure key name
# KMS_VAULT_ADDR=http://127.0.0.1:8200
# KMS_VAULT_TOKEN=
# KMS_VAULT_KEY_NAME=plaidify-master  # Vault transit key name

# ── Database ─────────────────────────────────────────────────────────────────
# SQLAlchemy URL. SQLite for development only: ENV=production refuses it.
# DATABASE_URL=sqlite:///plaidify.db
# DATABASE_URL=postgresql://user:password@localhost:5432/plaidify
# Pool per process (ignored for SQLite). Workers × (pool + overflow) must fit
# the server's max_connections (docs/DEPLOYMENT.md, "Database connection budget").
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=3600              # seconds before a connection is recycled

# ── Redis ────────────────────────────────────────────────────────────────────
# Required in production, and whenever more than one worker runs outside
# development: RSA keys, rate limits, link sessions, MFA state, locks, leases
# and the access-job queue. Unset by default; for example:
# REDIS_URL=redis://:password@localhost:6379/0
# REDIS_SOCKET_TIMEOUT_SECONDS=5.0  # link-session store and job dispatcher calls
# ENGINE_REDIS_SOCKET_TIMEOUT=2.0   # engine calls (MFA sessions, site rate limits)

# ── Server ───────────────────────────────────────────────────────────────────
# ENV=development                   # 'development', 'staging' or 'production'
# APP_NAME=Plaidify
# APP_VERSION=0.3.0b1               # reported by /, /status and /health/detailed
# DEBUG=false                       # must be false in production
# LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_FORMAT=json                   # 'json' (production) or 'text'
# Allowed CORS origins, comma separated. '*' is refused in production.
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080
# Redirect plain HTTP to HTTPS (except /health and /metrics) and send HSTS.
# Always on in production; behind a proxy it needs FORWARDED_ALLOW_IPS.
# ENFORCE_HTTPS=false
# Serve /docs, /redoc and /openapi.json in production (always served elsewhere).
# DOCS_ENABLED=false
# CONNECTORS_DIR=connectors         # directory holding the connector blueprints

# ── Accounts: registration and bootstrap ─────────────────────────────────────
# Public POST /auth/register. Default true, but in production it is off unless
# you set it explicitly.
# REGISTRATION_ENABLED=true
# Create this administrator at startup when all three are set. Never promotes
# an existing account; a clash with another account stops startup in production.
# All three are unset by default; for example:
# BOOTSTRAP_USER_USERNAME=admin
# BOOTSTRAP_USER_EMAIL=admin@example.com
# From your secret store, not source control; at most 72 bytes
# BOOTSTRAP_USER_PASSWORD=

# ── Sign-in tokens ───────────────────────────────────────────────────────────
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ── OAuth2 social login (POST /auth/oauth2) ──────────────────────────────────
# Clients send the provider's token; Plaidify checks it was issued to your app.
# With OAUTH_ENABLED=true, startup fails if an enabled provider lacks its ids.
# OAUTH_ENABLED=false
# OAUTH_ALLOWED_PROVIDERS=google,github
# Required when google is enabled
# OAUTH_GOOGLE_CLIENT_ID=
# Required when github is enabled
# OAUTH_GITHUB_CLIENT_ID=
# Required when github is enabled (GITHUB_CLIENT_SECRET is read too)
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_AUTO_REGISTER=true          # create an account on the first verified login

# ── Password-reset mail ──────────────────────────────────────────────────────
# Without SMTP_HOST and SMTP_FROM, POST /auth/forgot-password sends nothing
# (a warning is logged).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP login; unset: none
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Sender address, required together with SMTP_HOST
# SMTP_FROM=
# SMTP_STARTTLS=true                # disable only for a local relay
# SMTP_TIMEOUT_SECONDS=10.0
# Your reset page, e.g. https://app.example.com/reset?token={token}. Unset: the
# email carries the one-time code for POST /auth/reset-password.
# PASSWORD_RESET_URL=

# ── Hosted Link ──────────────────────────────────────────────────────────────
# Anonymous POST /link/sessions/public: refused in production unless enabled;
# PUBLIC_LINK_ALLOWED_ORIGINS (comma separated) restricts the calling origins.
# PUBLIC_LINK_SESSIONS_ENABLED=false
# PUBLIC_LINK_ALLOWED_ORIGINS=
# LINK_LAUNCH_TOKEN_EXPIRE_SECONDS=300     # lifetime of POST /link/bootstrap tokens
# Signs launch tokens: at least 32 characters, different from JWT_SECRET_KEY.
# Unset: a key derived from JWT_SECRET_KEY (HKDF).
# LINK_LAUNCH_SECRET=
# LINK_EVENT_KEEPALIVE_SECONDS=15.0        # keep-alive of GET /link/events/{token}

# ── Rate limiting (per client address; see FORWARDED_ALLOW_IPS) ──────────────
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH=5/minute          # /auth/token, /auth/oauth2, /auth/refresh
# RATE_LIMIT_CONNECT=10/minute      # POST /connect
# RATE_LIMIT_MFA=5/minute           # POST /mfa/submit
# RATE_LIMIT_ENCRYPTION=10/minute   # POST /encryption/session, GET /encryption/public_key/{token}
# Every other endpoint, per client address and path. Health checks, /metrics
# and the hosted page's own polling and event stream are exempt.
# RATE_LIMIT_DEFAULT=60/minute

# ── Observability and health ─────────────────────────────────────────────────
# Sentry error tracking; unset: off
# SENTRY_DSN=
# OpenTelemetry OTLP/gRPC endpoint for traces; unset: tracing off. https:// or
# no scheme uses TLS, http:// is plaintext. The standard OTEL_EXPORTER_OTLP_*
# variables also apply: _CERTIFICATE (custom CA), _CLIENT_CERTIFICATE and
# _CLIENT_KEY (mTLS), _HEADERS (collector auth), _INSECURE (override the scheme).
# For example:
# OTEL_ENDPOINT=https://otel-collector.example.com:4317
# Bearer token for GET /health/detailed. In production the endpoint answers
# 404 without it; elsewhere it is open when unset.
# HEALTH_CHECK_TOKEN=
# When set, GET /metrics requires 'Authorization: Bearer <METRICS_TOKEN>'.
# METRICS_TOKEN=
# Port where the access-job executor serves /metrics and /health (0 = off).
# ACCESS_WORKER_METRICS_PORT=9101

# ── Audit log and data retention ─────────────────────────────────────────────
# Signs the audit hash chain (HMAC-SHA256), at least 32 characters; keep it
# outside the database. Unset: derived from ENCRYPTION_KEY (HKDF).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUDIT_HMAC_KEY=
# The previous AUDIT_HMAC_KEY, kept while rotating it
# AUDIT_HMAC_KEY_PREVIOUS=
# AUDIT_RETENTION_DAYS=730          # older entries are pruned daily (chain kept verifiable)
# RESULT_RETENTION_DAYS=30          # stored access-job results are erased after this

# ── Access jobs ──────────────────────────────────────────────────────────────
# 'inprocess' runs jobs in the web process; 'redis-worker' dispatches them to
# the executor (python -m src.access_job_worker) through a Redis stream.
# ACCESS_JOB_EXECUTION_MODE=inprocess
# ACCESS_JOB_WORKER_CONCURRENCY=2          # jobs one executor process runs at once
# ACCESS_JOB_STREAM_KEY=plaidify:access_jobs:stream
# ACCESS_JOB_CONSUMER_GROUP=plaidify-access-jobs
# ACCESS_JOB_PAYLOAD_TTL=3600              # seconds a queued (encrypted) job payload lives in Redis
# ACCESS_JOB_WORKER_BLOCK_MS=5000          # how long an idle executor waits for the next job
# ACCESS_JOB_RECLAIM_IDLE_MS=30000         # a queued message this long without a heartbeat may be reclaimed
# ACCESS_JOB_HEARTBEAT_SECONDS=10.0        # how often a running job renews its lock and heartbeat
# ACCESS_JOB_STALE_AFTER_SECONDS=90        # a running job without a heartbeat this long is failed by the reaper
# ACCESS_JOB_QUEUE_TIMEOUT_SECONDS=600     # a job no executor picked up this long is failed
# ACCESS_JOB_DEADLINE_MARGIN_SECONDS=120   # added to ENGINE_TIMEOUT_SECONDS + MFA_TIMEOUT_SECONDS for the hard deadline
# ACCESS_JOB_DRAIN_SECONDS=25.0            # on SIGTERM, time running jobs get before they are cancelled
# ACCESS_JOB_REAPER_INTERVAL_SECONDS=30.0  # how often the reaper looks for stuck jobs

# ── Background services (scheduled refresh, webhook outbox, reaper) ──────────
# Each runs in one process at a time under a lease; in redis-worker mode only
# in the executor. Set false to keep this process out of the rotation.
# BACKGROUND_SERVICES_ENABLED=true
# REFRESH_TICK_SECONDS=30.0         # how often due refresh schedules are looked up
# REFRESH_MAX_CONCURRENCY=5         # scheduled refreshes running at once

# ── Webhooks ─────────────────────────────────────────────────────────────────
# WEBHOOK_MAX_ATTEMPTS=10           # attempts per event before it is marked failed
# WEBHOOK_RETRY_BASE_SECONDS=15.0   # first retry delay; doubles on each attempt
# WEBHOOK_RETRY_MAX_SECONDS=3600.0  # longest delay between attempts
# WEBHOOK_TIMEOUT_SECONDS=10.0      # timeout of one delivery request
# WEBHOOK_POLL_INTERVAL_SECONDS=5.0 # how often the outbox looks for due deliveries
# WEBHOOK_DELIVERY_RETENTION_DAYS=7 # finished deliveries stay listed this long
# Deliver to private-network addresses (development networks only; ignored in
# production). Loopback is always allowed outside production.
# WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# ── Engine ───────────────────────────────────────────────────────────────────
# ENGINE_TIMEOUT_SECONDS=300        # automation budget per connection (MFA wait excluded)
# MFA_TIMEOUT_SECONDS=300           # wait for the user's MFA answer before mfa_timeout
# MFA_MAX_ATTEMPTS=3                # codes accepted per challenge before the connection fails
# Site keys in CONNECTORS_DIR you vouch for, comma separated. Bundled
# connectors are trusted already; any other blueprint may not run JavaScript
# and never reaches private networks.
# ENGINE_TRUSTED_CONNECTORS=
# Run internal/fixture/sandbox connectors and let the browser reach loopback
# outside DEMO_MODE. Tests and local development only.
# ENGINE_ALLOW_INTERNAL_CONNECTORS=false

# ── Browser ──────────────────────────────────────────────────────────────────
# BROWSER_HEADLESS=true
# BROWSER_POOL_SIZE=5               # concurrent browser contexts per process
# BROWSER_IDLE_TIMEOUT=300          # seconds before an idle context is closed
# BROWSER_NAVIGATION_TIMEOUT=30000  # milliseconds
# BROWSER_ACTION_TIMEOUT=10000      # milliseconds per click / fill
# BROWSER_BLOCK_RESOURCES=true      # skip images, fonts and analytics
# BROWSER_STEALTH=true              # randomized viewport and user agent
# Per-phase read-only rules (declared submit targets, blocked steps and
# clicks; SECURITY.md). Domain scoping and the address policy apply either way.
# STRICT_READ_ONLY_MODE=true
# BROWSER_ALLOW_READ_DOWNLOADS=true # capture downloads in the read phase
# BROWSER_DOWNLOAD_ROOT=/tmp/plaidify-downloads
# BROWSER_MAX_DOWNLOAD_BYTES=10485760  # larger downloads are reported but not returned
# Chromium's OS sandbox. In Docker it needs the seccomp profile the compose
# files apply (deploy/seccomp/chromium.json; docs/DEPLOYMENT.md).
# BROWSER_CHROMIUM_SANDBOX=true
# Refuse private, loopback, link-local, CGNAT and metadata addresses for
# trusted connectors too (untrusted ones are always refused).
# BROWSER_BLOCK_PRIVATE_NETWORKS=true
# File that keeps learned selectors across restarts; must be writable (in the
# image /app is read-only, so use /tmp or a volume). Unset: memory only.
# PLAIDIFY_SELECTOR_CACHE_PATH=

# ── Resilience (circuit breakers and retries) ────────────────────────────────
# LLM_CIRCUIT_FAILURE_THRESHOLD=5
# LLM_CIRCUIT_RESET_SECONDS=30.0
# LLM_RETRY_MAX_ATTEMPTS=2
# BROWSER_CIRCUIT_FAILURE_THRESHOLD=5
# BROWSER_CIRCUIT_RESET_SECONDS=30.0

# ── LLM extraction (optional) ────────────────────────────────────────────────
# LLM_PROVIDER=openai               # 'openai' or 'anthropic'
# Unset: no LLM extraction, and /blueprints/generate answers 503
# LLM_API_KEY=
# Model name; unset: the provider's default
# LLM_MODEL=
# Base URL for Azure OpenAI or a compatible server
# LLM_BASE_URL=
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT=60.0                  # seconds
# LLM_TOKEN_BUDGET=30000            # page tokens sent to the model; larger pages are truncated
# Model tried when the primary one fails
# LLM_FALLBACK_MODEL=
# LLM_EFFORT=low                    # 'low', 'medium', 'high', 'xhigh', 'max'; empty = model default
# LLM_SERVER_SIDE_FALLBACKS=true    # Anthropic API: re-run a declined request on the fallback model

# ── Demo / sandbox (keep off in production) ──────────────────────────────────
# Makes the bundled sandbox connectors (demo_utility, demo_bank, demo_saas)
# discoverable and lets the browser reach them on 127.0.0.1.
# DEMO_MODE=false
# DEMO_PORTAL_URL=http://127.0.0.1:8799
# The demo portals (src/demo/, started by scripts/demo.py):
# DEMO_PORTAL_HOST=127.0.0.1   DEMO_PORTAL_PORT=8799   # GreenGrid utility
# DEMO_BANK_HOST=127.0.0.1     DEMO_BANK_PORT=8798     # Acme Bank
# DEMO_SAAS_HOST=127.0.0.1     DEMO_SAAS_PORT=8797     # CloudMail

# ── Process (read by gunicorn.conf.py) ───────────────────────────────────────
# Worker processes; default one per available CPU, 2 to 4. WEB_CONCURRENCY is
# read when GUNICORN_WORKERS is unset.
# GUNICORN_WORKERS=
# WEB_CONCURRENCY=
# GUNICORN_BIND=0.0.0.0:8000
# GUNICORN_TIMEOUT=120
# GUNICORN_GRACEFUL_TIMEOUT=30      # keep below the orchestrator's stop grace period
# GUNICORN_KEEPALIVE=5
# GUNICORN_LOG_LEVEL=info
# Peers allowed to set X-Forwarded-For/-Proto: your reverse proxy's addresses
# or networks. Must be set behind a proxy (docs/DEPLOYMENT.md).
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Prometheus multiprocess directory; unset = a private temp dir per start.
# PROMETHEUS_MULTIPROC_DIR=

# ── Container entrypoint (scripts/container-entrypoint.sh) ───────────────────
# When DATABASE_URL / REDIS_URL are unset, the image builds them from these
# (the compose files set them; passwords come from the *_FILE secrets).
# POSTGRES_HOST=postgres  POSTGRES_PORT=5432  POSTGRES_USER=plaidify  POSTGRES_DB=plaidify
# POSTGRES_PASSWORD= or POSTGRES_PASSWORD_FILE=   POSTGRES_SSLMODE=disable
# REDIS_HOST=redis  REDIS_PORT=6379  REDIS_DB=0  REDIS_SCHEME=redis   # rediss for TLS
# REDIS_PASSWORD= or REDIS_PASSWORD_FILE=
# Container health probe (plaidify-healthcheck): URL and timeout in seconds.
# HEALTHCHECK_URL=http://127.0.0.1:8000/health
# HEALTHCHECK_TIMEOUT=4

# ── Tools ────────────────────────────────────────────────────────────────────
# MCP server (python -m src.mcp_server):
# PLAIDIFY_SERVER_URL=http://localhost:8000
# A pk_… API key (sent as X-API-Key) or a user access token (sent as Bearer)
# PLAIDIFY_API_KEY=
# Host header values accepted when the HTTP transports bind a non-loopback address
# PLAIDIFY_MCP_ALLOWED_HOSTS=
# KMS migration (python -m scripts.migrate_to_kms):
# SOURCE_KMS_PROVIDER defaults to KMS_PROVIDER
# SOURCE_KMS_PROVIDER=
# TARGET_KMS_PROVIDER=
# Least-privilege database role (scripts/provision_app_db_role.py; DATABASE_URL = the admin URL):
# APP_DB_ROLE=plaidify_app
# APP_DB_PASSWORD=
# APP_DB_SCHEMA=public
# Backups (scripts/backup_db.sh): BACKUP_* variables, see docs/DISASTER_RECOVERY.md.
# Load tests (scripts/run-loadtest.sh): USERS, RATE, TIME, HOST, see docs/LOAD_TESTING.md.
