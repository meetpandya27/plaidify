# Allow-list: the build context holds only what the Dockerfile copies.
#
# Everything else — .git, .env files, .secrets/, nginx/certs/, backups/ and
# *.dump database dumps, virtualenvs, node_modules, local databases — never
# reaches the builder, so none of it can end up in an image layer. When the
# Dockerfile starts copying a new path, add it here.

*

!requirements.lock
!requirements-kms.lock
!gunicorn.conf.py
!alembic.ini
!alembic/
!connectors/
!frontend-next/
!src/
!scripts/container-entrypoint.sh
!scripts/healthcheck.py
!scripts/demo.py
!scripts/backup_db.sh
!scripts/provision_app_db_role.py

# Generated or machine-local files inside the allowed directories.
**/__pycache__
**/*.py[cod]
**/.DS_Store
**/*.db
**/*.sqlite3
frontend-next/node_modules
frontend-next/dist
frontend-next/ladle-build
frontend-next/**/*.tsbuildinfo
