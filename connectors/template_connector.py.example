"""Template for a Python connector.

This file is an example, not a connector: the engine loads only files named
``<site>_connector.py``, so it never runs as-is. To write one, copy it to
``connectors/<site>_connector.py`` and implement ``connect``. The engine runs it
in a worker thread under the same time budget as blueprint connectors
(ENGINE_TIMEOUT_SECONDS); give the class a ``tags`` list containing "internal"
or "sandbox" if it must only run in demo mode or tests.

Most sites are better served by a JSON blueprint, which gets the read-only
browser policy, MFA handling and extraction for free.
"""

from typing import Any, Dict

from src.core.connector_base import BaseConnector


class TemplateConnector(BaseConnector):
    """Template connector for new sites. Copy this file and implement the connect method."""

    tags = ["internal"]

    def connect(self, username: str, password: str) -> Dict[str, Any]:
        # Implement site-specific login and data extraction here.
        raise NotImplementedError("Copy this template and implement connect() for your site.")
