# Plaidify production environment template (docker-compose.production.yml)
# Copy to .env.production and fill in the values before starting the stack.
# Every other setting and its default is listed in .env.example.
#
# Not here on purpose: DATABASE_URL and REDIS_URL. The containers build them
# from .secrets/postgres_password and .secrets/redis_password at start, and the
# compose file sets ENV, the executor mode, the connection pool budget and the
# proxy trust (FORWARDED_ALLOW_IPS) itself.
#
# An empty value is not "unset": leave optional lines commented until you
# give them a value.

# Required secrets
ENCRYPTION_KEY=
# JWT_SECRET_KEY: at least 32 characters (openssl rand -hex 32)
JWT_SECRET_KEY=

# Separate keys (recommended). Unset, they are derived from the secrets above,
# so rotating ENCRYPTION_KEY then re-seals the audit chain and rotating
# JWT_SECRET_KEY invalidates pending hosted-link launch tokens.
# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUDIT_HMAC_KEY=
# At least 32 characters, different from JWT_SECRET_KEY
# LINK_LAUNCH_SECRET=

# Recommended server settings
APP_NAME=Plaidify
APP_VERSION=0.3.0b1
ENV=production
DEBUG=false
ENFORCE_HTTPS=true
LOG_LEVEL=INFO
LOG_FORMAT=json
# DOCS_ENABLED=false             # /docs, /redoc and /openapi.json stay off in production

# Accounts: self-registration is off in production unless enabled here.
# Provision the first administrator instead (created at startup, idempotent;
# remove the three BOOTSTRAP_USER_* values once the account exists):
# REGISTRATION_ENABLED=false
# BOOTSTRAP_USER_USERNAME=admin
# BOOTSTRAP_USER_EMAIL=admin@example.com
# BOOTSTRAP_USER_PASSWORD=
# With registration enabled, sign-ups prove their email address first and need
# the mail settings below (startup refuses otherwise). false creates accounts at
# once, but registration then reveals which usernames and addresses are taken.
# REGISTRATION_EMAIL_VERIFICATION=true

# Password-reset and sign-up mail (without SMTP_HOST and SMTP_FROM no email is sent)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# PASSWORD_RESET_URL=https://app.example.com/reset?token={token}
# EMAIL_VERIFICATION_URL=https://app.example.com/verify?token={token}

# Networking and browser limits
CORS_ORIGINS=https://app.example.com
PUBLIC_LINK_SESSIONS_ENABLED=false
# PUBLIC_LINK_ALLOWED_ORIGINS=https://app.example.com
# LINK_LAUNCH_TOKEN_EXPIRE_SECONDS=300
BROWSER_HEADLESS=true
BROWSER_POOL_SIZE=5
BROWSER_IDLE_TIMEOUT=300
BROWSER_NAVIGATION_TIMEOUT=30000
BROWSER_ACTION_TIMEOUT=10000
STRICT_READ_ONLY_MODE=true

# Health and metrics. In production GET /health/detailed answers 404 until
# HEALTH_CHECK_TOKEN is set. /metrics is open to anyone who can reach the API
# port unless METRICS_TOKEN is set (nginx in this stack does not publish it);
# the monitoring stack's Prometheus sends it from .secrets/metrics_token.
# HEALTH_CHECK_TOKEN=
# METRICS_TOKEN=

# Optional observability
# SENTRY_DSN=
# OTEL_ENDPOINT=https://otel-collector.example.com:4317

# Optional LLM extraction
LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=

# Optional managed KMS (needs an image built with --build-arg INSTALL_KMS=true;
# docs/KMS_INTEGRATION.md)
# KMS_PROVIDER=aws
# AWS key ARN or alias
# KMS_KEY_ID=

# Gunicorn tuning (gunicorn.conf.py). Default workers: one per CPU, 2 to 4.
# Keep GUNICORN_WORKERS × (DB_POOL_SIZE + DB_MAX_OVERFLOW), plus the
# executor's pool, inside Postgres' max_connections (100 by default). The
# compose file sets DB_POOL_SIZE=5 and DB_MAX_OVERFLOW=5; like POSTGRES_USER
# below, change those through the shell or --env-file.
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# Detached access job executor
ACCESS_JOB_WORKER_CONCURRENCY=2

# Database naming. The compose file substitutes these into both Postgres and
# the app, and compose substitution only reads the shell or an --env-file:
# to change them, run `docker compose --env-file .env.production -f
# docker-compose.production.yml ...` (the defaults are plaidify / plaidify).
POSTGRES_USER=plaidify
POSTGRES_DB=plaidify

# Optional image override when pulling from a registry
# PLAIDIFY_IMAGE=ghcr.io/your-org/plaidify:<commit-sha>
